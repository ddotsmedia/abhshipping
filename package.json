{
  "name": "abhshipping",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "db:studio": "cd apps/web && pnpm prisma studio"
  },
  "devDependencies": {
    "prettier": "3.4.2",
    "turbo": "2.3.3",
    "typescript": "5.7.2"
  },
  "packageManager": "pnpm@9.14.2",
  "engines": {
    "node": ">=22.11.0"
  }
}
